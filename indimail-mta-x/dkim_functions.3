.TE
.ad
.PP
When the library was built with OpenSSL older than 1.1.1 every function fails:
those that return an \fIint\fR return \fBDKIM_OPENSSL_TOO_OLD\fR, those that
return a pointer return NULL, and \fBdkim_status_text\fR() gives "OpenSSL
version too old on this system". A program can test for this once at start up
with \fBexit_if_old\fR().
.SH NOTES
.IP \(bu 2
Some systems (Fedora, RHEL and others, through their crypto policy) make OpenSSL
refuse rsa\-sha1 signatures, although rsa\-sha256 works with the same key.
\fBdkim_sign_get\fR() then fails with \fBDKIM_ALGORITHM_NOT_ALLOWED\fR, not with
\fBDKIM_EVP_SIGN_FAILURE\fR. A signature with \fIa=rsa\-sha1\fR that is verified
gets that result instead of \fBDKIM_SIGNATURE_BAD\fR, so that a message is not
rejected for something that is not wrong with the signature (set
\fInRejectSha1\fR to get \fBDKIM_SIGNATURE_BAD\fR). The result has no
\fBDKIMVERIFY\fR letter. The system administrator can allow rsa\-sha1 again (for
Fedora and RHEL: \fBupdate\-crypto\-policies \-\-set DEFAULT:SHA1\fR). If OpenSSL
refuses only after having accepted the digest, this cannot be told apart from a
bad signature and \fBDKIM_SIGNATURE_BAD\fR is returned.
.IP \(bu 2
Public key records: \fIk=rsa\fR keys are base64 DER (SubjectPublicKeyInfo or
PKCS#1); \fIk=ed25519\fR keys are the raw 32 byte key in base64 (RFC 8463)
\- the SubjectPublicKeyInfo form is also accepted. The key record flags
\fIt=y\fR (testing) and \fIt=s\fR (strict, \fIi=\fR must equal \fId=\fR), and the
tags \fIh=\fR, \fIs=\fR and \fIg=\fR are honored.
.IP \(bu 2
Verification does not enforce RFC 8301: rsa\-sha1 signatures are accepted,
RSA keys of 1024 bits or more are accepted.
.IP \(bu 2
A signature is rejected as \fBDKIM_BAD_IDENTITY\fR when \fIi=\fR is not under
\fId=\fR, as \fBDKIM_SIGNATURE_EXPIRED\fR when \fIx=\fR has passed, and as
\fBDKIM_STAT_INCOMPAT\fR when \fIv=\fR is not 1.
.IP \(bu 2
The total size of the header of a message is limited to 16 MB. There is no
limit on the size of the body.
.IP \(bu 2
Contexts do not share state, so different contexts may be used by different
threads. The base64 decoding table is initialized on first use without a
lock; do the first call from one thread if you use threads.
.IP \(bu 2
\fBdkim_sign_domain\fR() and \fBdkim_verify_author_domain\fR() extract the
domain from the first address in the header. They do not implement the full
RFC 5322 address syntax.
.SH EXAMPLES
.SS Signing a message with two keys
Reads a message on standard input and writes an RSA and an Ed25519 signature
to standard output. The message is read once.
.PP
.if n .RS
.nf
/*
 * ex_sign - sign the message on standard input with two keys
 *
 * cc -o ex_sign ex_sign.c dkim_functions.c -lcrypto
 * ./ex_sign rsa.pem ed25519.pem < mail.txt > signatures.txt
 */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <strings.h>
#include <time.h>
#include <unistd.h>
#include "dkim_functions.h"

/* header callback: return 1 to sign the header, 0 to leave it out */
static int
sign_this(const char *header)
{
	return strncasecmp(header, "Received:", 9) &&
		strncasecmp(header, "Return-Path:", 12) &&
		strncasecmp(header, "DKIM-Signature:", 15);
}

static char *
read_file(const char *fn)
{
	FILE           *fp = fopen(fn, "r");
	char           *buf;
	long            n;

	if (!fp)
		return NULL;
	fseek(fp, 0, SEEK_END);
	n = ftell(fp);
	rewind(fp);
	if (!(buf = malloc(n + 1)))
		return NULL;
	buf[fread(buf, 1, n, fp)] = 0;
	fclose(fp);
	return buf;
}

int
main(int argc, char **argv)
{
	DKIMSignOptions opts;
	DKIMSign       *s;
	char            buf[8192], *pem, *sig;
	ssize_t         n;
	int             ret;

	if (argc != 3) {
		fprintf(stderr, "usage: ex_sign rsa.pem ed25519.pem < mail\en");
		return 100;
	}
	exit_if_old(111);        /* OpenSSL older than 1.1.1: give up at once */

	memset(&opts, 0, sizeof(opts));
	opts.pfnHeaderCallback = sign_this;
	strcpy(opts.szDefaultDomain, "example.com"); /* used if no From: header */
	if (!(s = dkim_sign_new(&opts))) {
		fprintf(stderr, "dkim_sign_new failed\en");
		return 111;
	}
	/* 1. feed the message, any chunk size, LF or CRLF line ends */
	while ((n = read(0, buf, sizeof(buf))) > 0) {
		if ((ret = dkim_sign_process(s, buf, n))) {
			fprintf(stderr, "%s\en", dkim_status_text(ret, NULL));
			dkim_sign_free(s);
			return 111;
		}
	}
	/* 2. one signature per call, the message is not read again */
	opts.nCanon = DKIM_SIGN_RELAXED;
	opts.nHash = DKIM_HASH_SHA256;
	opts.expireTime = time(NULL) + 7 * 86400;
	strcpy(opts.szSelector, "rsa");
	if (!(pem = read_file(argv[1])) ||
			(ret = dkim_sign_get(s, &opts, pem, &sig))) {
		fprintf(stderr, "%s: %s\en", argv[1], ret ? dkim_status_text(ret, NULL) : "cannot read");
		dkim_sign_free(s);
		return 111;
	}
	fputs(sig, stdout);      /* "DKIM-Signature: ...\en" */
	dkim_free(sig);
	free(pem);

	opts.nHash = DKIM_HASH_ED25519;
	strcpy(opts.szSelector, "ed");
	if (!(pem = read_file(argv[2])) ||
			(ret = dkim_sign_get(s, &opts, pem, &sig))) {
		fprintf(stderr, "%s: %s\en", argv[2], ret ? dkim_status_text(ret, NULL) : "cannot read");
		dkim_sign_free(s);
		return 111;
	}
	fputs(sig, stdout);
	dkim_free(sig);
	free(pem);
	dkim_sign_free(s);
	return 0;
}
.fi
.if n .RE
.SS Verifying a message
Prints the result of every signature and the overall status. \fBdns_text\fR()
is the program's own TXT record lookup.
.PP
.nf
/*
 * ex_verify - verify every DKIM-Signature of the message on standard input
 *
 * cc -o ex_verify ex_verify.c dkim_functions.c -lcrypto -lyourdns
 * ./ex_verify < signed-mail.txt
 */
#include <stdio.h>
#include <string.h>
#include <unistd.h>
#include "dkim_functions.h"

extern char *dns_text(char *); /* your TXT lookup: "e=temp;" / "e=perm;" on error */

static char *
lookup(const char *name)
{
	return dns_text((char *) name);
}

int
main(void)
{
	DKIMVerifyOptions opts;
	DKIMVerifyDetails *d;
	DKIMVerify     *v;
	char            buf[8192];
	ssize_t         n;
	int             i, nok, nsigs, ret;

	exit_if_old(111);
	memset(&opts, 0, sizeof(opts));
	opts.nSubjectRequired = 1;       /* Subject: must be signed if present */
	opts.pfnDnsCallback = lookup;
	if (!(v = dkim_verify_new(&opts))) {
		fprintf(stderr, "dkim_verify_new failed\en");
		return 111;
	}
	while ((n = read(0, buf, sizeof(buf))) > 0) {
		if ((ret = dkim_verify_process(v, buf, n))) {
			fprintf(stderr, "%s\en", dkim_status_text(ret, NULL));
			dkim_verify_free(v);
			return 111;
		}
	}
	if ((ret = dkim_verify_finish(v, &nsigs, &d))) {
		fprintf(stderr, "%s\en", dkim_status_text(ret, NULL));
		dkim_verify_free(v);
		return 111;
	}
	for (i = 0; i < nsigs; i++)      /* one result per DKIM-Signature header */
		printf("%d: d=%s s=%s a=%s %s (%d)\en", i + 1,
				d[i].szDomain ? d[i].szDomain : "?",
				d[i].szSelector ? d[i].szSelector : "?",
				d[i].szAlgorithm ? d[i].szAlgorithm : "?",
				dkim_code_name(d[i].nResult), d[i].nResult);
	ret = dkim_verify_status(nsigs, d);  /* one good signature is enough */
	nok = dkim_verify_count(nsigs, d);   /* how many of them verified */
	printf("DKIM-Status: %s\en", dkim_status_text(ret, NULL));
	if (nok > 0 && nok < nsigs)
		printf("\t(%d of %d signatures verified)\en", nok, nsigs);
	dkim_verify_free(v);             /* invalidates d[] */
	return ret < 0;
}
.fi
.SS Testing without DNS
.nf
DKIMVerifyOptions opts;

memset(&opts, 0, sizeof(opts));
opts.pszSelectorOverride =
    "v=DKIM1; k=rsa; p=MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8A...";
v = dkim_verify_new(&opts);   /* no DNS callback needed */
.fi
.SS Two signatures from different domains
\fBd=\fR is taken from the From header unless \fBszDomain\fR is set. To sign
the same message for another domain, create a second context, or set
\fBszDomain\fR when creating the context:
.PP
.nf
strcpy(opts.szDomain, "example.org");
s = dkim_sign_new(&opts);
.fi
